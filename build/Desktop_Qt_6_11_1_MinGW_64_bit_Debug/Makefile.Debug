####### Compile

debug/Caballo.o: ../../Caballo.cpp ../../Caballo.h \
		../../Pieza.h \
		../../coordenada.h \
		../../Tablero.h \
		../../Coordenada.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\Caballo.o ..\..\Caballo.cpp

debug/Coordenada.o: ../../Coordenada.cpp ../../Coordenada.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug\Coordenada.o ..\..\Coordenada.cpp

